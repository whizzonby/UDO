# API base URL — no trailing slash, no /api suffix
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Production (update before deploying):
# NEXT_PUBLIC_API_URL=https://api.udowedding.com/api

# App store links. Play Store is live and has a hardcoded default in
# lib/appLinks.ts — only set NEXT_PUBLIC_PLAY_STORE_URL to override it.
# iOS isn't published yet: leave NEXT_PUBLIC_APP_STORE_URL blank and the UI
# shows an honest "coming soon" state instead of a dead link.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
