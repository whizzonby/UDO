# API base URL — no trailing slash, no /api suffix
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Production (update before deploying):
# NEXT_PUBLIC_API_URL=https://api.udowedding.com/api

# App store links for the post-checkout download page — leave blank until
# the app is actually published; the page shows an honest "coming soon"
# state instead of a dead link when these are unset.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
