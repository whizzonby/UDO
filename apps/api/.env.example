APP_NAME=UDO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@udowedding.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sentry — leave SENTRY_LARAVEL_DSN blank to disable error reporting (e.g. local dev)
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_TRACES_SAMPLE_RATE=0.2

# OpenWeatherMap — free tier, no credit card required.
OPENWEATHER_API_KEY=

# Spoonacular — recipe search for the Menu Builder. Free tier is 50 points/day
# (spoonacular.com/food-api). Leave empty to disable recipe search; the meal
# name field falls back to plain typing when unset.
SPOONACULAR_API_KEY=

# Google Places Autocomplete — hotel/lodging name search for "Add hotel
# block". Needs a Google Cloud project with billing + the Places API enabled
# (console.cloud.google.com/google/maps-apis). Leave empty to disable; the
# hotel name field falls back to plain typing when unset.
GOOGLE_PLACES_API_KEY=

# Google Sign-In — client IDs from Google Cloud Console (OAuth 2.0 credentials).
# GOOGLE_IOS_CLIENT_ID is the iOS-specific client id; GOOGLE_CLIENT_ID covers
# Android/Web. GOOGLE_CLIENT_SECRET/GOOGLE_REDIRECT_URI are only needed if a
# server-side web OAuth flow is used in addition to native mobile sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Sign in with Apple — from Apple Developer (Certificates, Identifiers & Profiles).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Stripe - real one-time $45 lifetime-access checkout (optional; the
# checkout page shows an honest "not set up yet" state when these are blank)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Native in-app purchase (StoreKit / Google Play Billing) - real one-time $45
# lifetime unlock for users who download the app directly instead of buying
# on the website first. Optional; /billing/verify-purchase returns an honest
# "not configured" response per-platform when these are blank.
APPLE_IAP_SHARED_SECRET=
IOS_LIFETIME_PRODUCT_ID=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=
ANDROID_LIFETIME_PRODUCT_ID=

# Twilio - SMS and WhatsApp delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_VALIDATE_WEBHOOKS=true

# Pinterest - inspiration board import (optional; Gallery shows an honest
# "not configured" state when these are blank)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=

# Guest invitation links expire by default to reduce long-lived token exposure.
GUEST_TOKEN_DEFAULT_EXPIRY_DAYS=365

# Billing plan price IDs. Leave blank to use local plan changes only.
STRIPE_PRICE_FREE_MONTHLY=
STRIPE_PRICE_FREE_ANNUAL=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_ANNUAL=
