    { name: 'Michael Chen', email: 'michael@email.com', rsvp: 'Attending', meal: 'Standard', plusOne: false },
    { name: 'Emily Rodriguez', email: 'emily@email.com', rsvp: 'Pending', meal: '-', plusOne: true },
    { name: 'David Park', email: 'david@email.com', rsvp: 'Attending', meal: 'Vegan', plusOne: false },
