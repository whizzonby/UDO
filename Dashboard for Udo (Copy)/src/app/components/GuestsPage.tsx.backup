                  <h4 className="text-[14px] font-medium text-gray-800">Urgent (Arriving within 72 hours)</h4>
                </div>
                <div className="space-y-2">
                  {[
                    { name: 'Emily Rodriguez', city: 'Chicago, ORD', arrival: 'Jun 14', hotel: 'Not set', transport: 'Not set' },
