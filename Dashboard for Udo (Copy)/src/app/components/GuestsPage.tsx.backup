                          <div className="text-gray-500 mb-0.5">Arrival</div>
                          <div className="text-gray-800 font-medium">{guest.arrival}</div>
                        </div>
                        <div>
                          <div className="text-gray-500 mb-0.5">Hotel</div>
                          <div className="text-gray-800 font-medium">{guest.hotel}</div>
                        </div>
                        <div>
                          <div className="text-gray-500 mb-0.5">Transport</div>
                          <div className="text-gray-800 font-medium">{guest.transport}</div>
                        </div>
