                      className="w-full p-4 bg-[#F7F7F5] rounded-xl border border-[#E5E5E5] hover:border-[#1F4D2B] transition-all text-left"
                    >
                      <div className="flex items-center gap-3 mb-3">
                        <div className="w-10 h-10 rounded-full bg-white flex items-center justify-center text-[14px] font-medium text-[#1F4D2B]">
                          {guest.name.split(' ').map(n => n[0]).join('')}
                        </div>
                        <div className="flex-1">
                          <div className="text-[14px] font-medium text-gray-800">{guest.name}</div>
                          <div className="text-[12px] text-gray-600">{guest.city}</div>
                        </div>
                        <span className="px-2.5 py-1 bg-gray-200 text-gray-700 text-[11px] rounded-full font-medium">Missing details</span>
                      </div>
                      <div className="grid grid-cols-3 gap-2 text-[12px]">
                        <div>
                          <div className="text-gray-500 mb-0.5">Arrival</div>
                          <div className="text-gray-800 font-medium">{guest.arrival}</div>
                        </div>
                        <div>
                          <div className="text-gray-500 mb-0.5">Hotel</div>
                          <div className="text-gray-800 font-medium">{guest.hotel}</div>
                        </div>
                        <div>
                          <div className="text-gray-500 mb-0.5">Transport</div>
                          <div className="text-gray-800 font-medium">{guest.transport}</div>
                        </div>
                      </div>
                    </button>
                  ))}
                </div>
              </div>

              {/* Group 3: Partial Completion */}
              <div>
                <div className="flex items-center gap-2 mb-3">
                  <div className="w-2 h-2 rounded-full bg-[#1F4D2B]"></div>
                  <h4 className="text-[14px] font-medium text-gray-800">Partial Completion</h4>
                </div>
                <div className="space-y-2">
                  {[
                    { name: 'Sarah Johnson', city: 'New York, JFK', arrival: 'Jun 14', hotel: 'Confirmed', transport: 'Needs assignment' },
                    { name: 'David Park', city: 'Boston, BOS', arrival: 'Jun 13', hotel: 'Confirmed', transport: 'Assigned' },
                  ].map((guest, index) => (
                    <button
                      key={index}
                      onClick={() => setShowGuestLogisticsDetail(true)}
                      className="w-full p-4 bg-[#F7F7F5] rounded-xl border border-[#E5E5E5] hover:border-[#1F4D2B] transition-all text-left"
                    >
                      <div className="flex items-center gap-3 mb-3">
                        <div className="w-10 h-10 rounded-full bg-white flex items-center justify-center text-[14px] font-medium text-[#1F4D2B]">
                          {guest.name.split(' ').map(n => n[0]).join('')}
                        </div>
                        <div className="flex-1">
                          <div className="text-[14px] font-medium text-gray-800">{guest.name}</div>
                          <div className="text-[12px] text-gray-600">{guest.city}</div>
                        </div>
                        {guest.transport === 'Assigned' && guest.hotel === 'Confirmed' && (
                          <span className="px-2.5 py-1 bg-[#E8F3EC] text-[#1F4D2B] text-[11px] rounded-full font-medium">Ready</span>
