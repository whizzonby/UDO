                        <div className="w-10 h-10 rounded-full bg-white flex items-center justify-center text-[14px] font-medium text-[#1F4D2B]">
                          {guest.name.split(' ').map(n => n[0]).join('')}
                        </div>
                        <div className="flex-1">
                          <div className="text-[14px] font-medium text-gray-800">{guest.name}</div>
                          <div className="text-[12px] text-gray-600">{guest.city}</div>
                        </div>
                        <span className="px-2.5 py-1 bg-[#C75C6F] text-white text-[11px] rounded-full font-medium">Needs attention</span>
