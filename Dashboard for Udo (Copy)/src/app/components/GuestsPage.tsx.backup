import { useState } from 'react';
import { Search, Plus, Mail, Link as LinkIcon, Eye, MapPin, MessageSquare, Users as UsersIcon, ChevronRight, Calendar, MapPinIcon, Clock, AlertCircle, Send, X, Check, Hotel, Plane, Bus, Copy, Edit } from 'lucide-react';

type GuestTab = 'overview' | 'guests' | 'invites' | 'landing' | 'messages' | 'logistics';
type GuestViewType = 'attending' | 'travelling' | 'wedding-party' | 'pending';
type VisibilityGroup = 'All Guests' | 'Wedding Party' | 'Family' | 'Travelling Guests';

interface HotelData {
  id: string;
  name: string;
  address: string;
  distance: string;
  priceRange: string;
  bookingLink: string;
  notes: string;
  recommended: boolean;
}

interface TransportGroup {
  id: string;
  name: string;
  pickupLocation: string;
  time: string;
  notes: string;
}

export default function GuestsPage() {
  const [activeTab, setActiveTab] = useState<GuestTab>('overview');
