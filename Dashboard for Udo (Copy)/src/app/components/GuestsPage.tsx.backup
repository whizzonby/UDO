                >
                  <X size={20} className="text-gray-600" />
                </button>
                <h1 className="text-2xl text-[#285301] flex-1 text-center" style={{ fontFamily: 'Crimson Pro, serif' }}>Guest Insights</h1>
                <div className="w-9"></div>
