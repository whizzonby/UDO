                        <div className="flex-1 py-2 px-3 bg-white rounded-lg text-center text-[12px] text-gray-700 font-medium hover:bg-[#E5E5E5] transition-colors">Request info</div>
                        <div className="flex-1 py-2 px-3 bg-white rounded-lg text-center text-[12px] text-gray-700 font-medium hover:bg-[#E5E5E5] transition-colors">Assign hotel</div>
                      </div>
