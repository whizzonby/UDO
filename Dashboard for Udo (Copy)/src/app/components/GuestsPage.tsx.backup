                      <div className="space-y-2">
                        {/* Show different events based on guest type */}
                        {guestViewType === 'attending' && (
                          <>
                            <div className="p-3 bg-white border border-gray-100 rounded-lg">
                              <div className="text-[12px] font-medium text-gray-800 mb-1">Ceremony</div>
                              <div className="text-[11px] text-gray-600">Saturday, 4:00 PM • Sunset Gardens</div>
                            </div>
                            <div className="p-3 bg-white border border-gray-100 rounded-lg">
                              <div className="text-[12px] font-medium text-gray-800 mb-1">Reception</div>
                              <div className="text-[11px] text-gray-600">Saturday, 7:00 PM • Main Ballroom</div>
                            </div>
                          </>
                        )}

                        {guestViewType === 'wedding-party' && (
                          <>
                            <div className="p-3 bg-[#f8edeb] border border-[#f194b2]/20 rounded-lg">
                              <div className="text-[12px] font-medium text-[#285301] mb-1">Rehearsal Dinner</div>
                              <div className="text-[11px] text-gray-600">Friday, 6:00 PM • Beachfront Restaurant</div>
                              <div className="text-[10px] text-[#d45d78] mt-1">Wedding party only</div>
                            </div>
                            <div className="p-3 bg-white border border-gray-100 rounded-lg">
                              <div className="text-[12px] font-medium text-gray-800 mb-1">Ceremony</div>
                              <div className="text-[11px] text-gray-600">Saturday, 4:00 PM • Sunset Gardens</div>
                            </div>
                            <div className="p-3 bg-white border border-gray-100 rounded-lg">
                              <div className="text-[12px] font-medium text-gray-800 mb-1">Reception</div>
                              <div className="text-[11px] text-gray-600">Saturday, 7:00 PM • Main Ballroom</div>
                            </div>
                          </>
                        )}

                        {guestViewType === 'travelling' && (
                          <>
                            <div className="p-3 bg-[#f8edeb] border border-[#f194b2]/20 rounded-lg">
                              <div className="text-[12px] font-medium text-[#285301] mb-1">Transport Details</div>
                              <div className="text-[11px] text-gray-600">Shuttle pickup: 3:15 PM from hotel lobby</div>
                              <div className="text-[10px] text-[#d45d78] mt-1">Travelling guests</div>
                            </div>
                            <div className="p-3 bg-white border border-gray-100 rounded-lg">
                              <div className="text-[12px] font-medium text-gray-800 mb-1">Ceremony</div>
                              <div className="text-[11px] text-gray-600">Saturday, 4:00 PM • Sunset Gardens</div>
                            </div>
                            <div className="p-3 bg-white border border-gray-100 rounded-lg">
                              <div className="text-[12px] font-medium text-gray-800 mb-1">Reception</div>
                              <div className="text-[11px] text-gray-600">Saturday, 7:00 PM • Main Ballroom</div>
                            </div>
                          </>
                        )}

                        {guestViewType === 'pending' && (
                          <div className="p-4 bg-[#f8edeb]/40 rounded-lg text-center">
                            <div className="text-[12px] text-gray-600 mb-2">RSVP to view your personalized schedule</div>
                            <button className="px-4 py-2 bg-[#285301] text-white rounded-lg text-[11px] font-medium">
                              RSVP Now
                            </button>
                          </div>
                        )}
                      </div>
                    </div>

                    {/* Travel & Stay Section */}
                    {guestViewType !== 'pending' && (guestViewType === 'travelling' || guestViewType === 'wedding-party') && (
                      <div>
                        <div className="text-[13px] font-medium text-gray-800 mb-2">Travel & Stay</div>
                        <div className="text-[11px] text-gray-600 mb-3">
                          Everything you need to plan your journey and stay for the wedding.
                        </div>

                        {/* Hotels */}
                        <div className="mb-3">
                          <div className="text-[12px] font-medium text-gray-800 mb-2">Hotels</div>
                          <div className="space-y-2">
                            {savedHotels.slice(0, 2).map((hotel) => (
                              <div key={hotel.id} className="p-3 bg-white border border-gray-100 rounded-lg">
                                <div className="flex items-start justify-between mb-1">
                                  <div className="flex-1">
                                    <div className="text-[12px] font-medium text-gray-800">{hotel.name}</div>
                                    <div className="text-[10px] text-gray-600 mt-0.5">{hotel.distance}</div>
                                  </div>
                                  {hotel.recommended && (
                                    <span className="text-[9px] px-2 py-0.5 bg-[#285301] text-white rounded-full">
                                      Recommended
                                    </span>
                                  )}
                                </div>
                                <button
                                  onClick={() => {
                                    setSelectedHotelForDetails(hotel.id);
                                    setShowHotelDetailsModal(true);
                                  }}
                                  className="text-[11px] text-[#285301] font-medium hover:underline"
                                >
                                  View details
                                </button>
                              </div>
                            ))}
                          </div>
                        </div>

                        {/* Transport */}
                        {transportGroups.length > 0 && (
                          <div className="mb-3">
                            <div className="text-[12px] font-medium text-gray-800 mb-2">Transport</div>
                            <div className="space-y-2">
                              {transportGroups.map((transport) => (
                                <div key={transport.id} className="p-3 bg-white border border-gray-100 rounded-lg">
                                  <div className="text-[12px] font-medium text-gray-800">{transport.name}</div>
                                  <div className="text-[10px] text-gray-600 mt-1">
                                    {transport.pickupLocation} • {transport.time}
                                  </div>
                                </div>
                              ))}
                            </div>
                          </div>
                        )}

                        {/* Flights */}
                        {travelStayData.showFlightSuggestions && (
                          <div className="mb-3">
                            <div className="text-[12px] font-medium text-gray-800 mb-2">Getting There</div>
                            <div className="p-3 bg-white border border-gray-100 rounded-lg">
                              <div className="text-[11px] text-gray-800 mb-1">
                                Nearest airport: {travelStayData.nearestAirport}
                              </div>
                              <div className="text-[10px] text-gray-600">
                                Multiple daily flights from major cities
                              </div>
                            </div>
                          </div>
