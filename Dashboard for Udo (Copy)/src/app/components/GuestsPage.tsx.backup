                onClick={() => setShowEditHotels(true)}
                className="w-full bg-[#1F4D2B] text-white py-3.5 rounded-xl text-[14px] flex items-center justify-center gap-2 hover:bg-[#163920] transition-colors"
                style={{ fontWeight: 500 }}
              >
                Assign hotels to guests
              </button>
            </div>

            {/* Section 6: Transport Setup */}
            <div className="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
              <h3 className="text-[18px] font-medium text-[#1F4D2B] mb-2" style={{ fontFamily: 'Playfair Display, serif' }}>
                Transport Setup
              </h3>
              <p className="text-[13px] text-gray-600 mb-4">
                Manage movement logistics
              </p>

              <div className="p-5 bg-[#F7F7F5] rounded-xl mb-4">
                <div className="grid grid-cols-2 gap-4 text-[14px]">
                  <div>
                    <div className="text-gray-600 mb-1">Guests require transport</div>
                    <div className="text-[24px] font-medium text-[#C75C6F]">12</div>
                  </div>
                  <div>
                    <div className="text-gray-600 mb-1">Seats configured</div>
                    <div className="text-[24px] font-medium text-[#1F4D2B]">8</div>
                  </div>
                </div>
              </div>

              <button
                onClick={() => setShowEditTransport(true)}
                className="w-full bg-[#1F4D2B] text-white py-3.5 rounded-xl text-[14px] flex items-center justify-center gap-2 hover:bg-[#163920] transition-colors"
                style={{ fontWeight: 500 }}
              >
                Edit transport plan
              </button>
            </div>
          </div>
        )}
      </div>

      {/* Invite Preview Modal */}
      {showInvitePreview && (
        <div className="fixed inset-0 bg-black/50 z-50 flex items-end" onClick={() => setShowInvitePreview(false)}>
          <div className="bg-white w-full rounded-t-3xl p-6 max-h-[85vh] overflow-y-auto" onClick={(e) => e.stopPropagation()}>
            <div className="w-12 h-1 bg-gray-300 rounded-full mx-auto mb-6"></div>
            <div className="bg-gradient-to-br from-[#f8edeb] via-white to-[#f8edeb] p-8 rounded-2xl border-2 border-[#f194b2]/30">
              <div className="text-center">
                <div className="text-xs text-[#d45d78] mb-2 tracking-widest uppercase">You are invited to celebrate</div>
                <div className="text-4xl text-[#285301] mb-4" style={{ fontFamily: 'Crimson Pro, serif' }}>
                  Olivia & Aaron
                </div>
                <div className="h-[1px] bg-gradient-to-r from-transparent via-[#f194b2] to-transparent my-4"></div>
                <div className="text-sm text-gray-600 mb-2">Saturday, June 15th, 2026</div>
                <div className="text-sm text-gray-600 mb-4">4:00 PM</div>
                <div className="text-base text-gray-700 mb-6">
                  Sunset Gardens<br />
                  Montego Bay, Jamaica
                </div>
                <div className="h-[1px] bg-gradient-to-r from-transparent via-[#f194b2] to-transparent my-4"></div>
                <p className="text-xs italic text-gray-600">
                  "Love is composed of a single soul inhabiting two bodies."
                </p>
              </div>
            </div>
            <button className="w-full bg-[#285301] text-white py-3 rounded-xl font-medium mt-6">
              Close preview
            </button>
          </div>
        </div>
      )}

      {/* Guest Detail Modal */}
      {showGuestDetail && (
        <div className="fixed inset-0 bg-black/50 z-50 flex items-end" onClick={() => setShowGuestDetail(false)}>
          <div className="bg-white w-full rounded-t-3xl max-h-[90vh] overflow-y-auto" onClick={(e) => e.stopPropagation()}>
            <div className="sticky top-0 bg-white border-b border-gray-100 p-6 pb-4">
              <div className="w-12 h-1 bg-gray-300 rounded-full mx-auto mb-4"></div>
              <div className="flex items-center justify-between">
                <h2 className="text-[22px] text-[#285301]" style={{ fontFamily: 'Crimson Pro, serif' }}>Sarah Johnson</h2>
                <button onClick={() => setShowGuestDetail(false)} className="text-gray-400 hover:text-gray-600">
                  <X size={24} />
                </button>
              </div>
            </div>

            <div className="p-6 space-y-6">
              {/* Basic details */}
              <div>
                <h3 className="text-[15px] font-medium text-gray-800 mb-3">Basic details</h3>
                <div className="space-y-3">
                  <div className="flex items-center justify-between p-3 bg-[#f8edeb] rounded-xl">
                    <div>
                      <div className="text-[11px] text-gray-600 mb-0.5">Name</div>
                      <p className="text-[14px] font-medium text-gray-800">Sarah Johnson</p>
                    </div>
                    <Edit size={16} className="text-gray-400" />
                  </div>
                  <div className="flex items-center justify-between p-3 bg-[#f8edeb] rounded-xl">
                    <div>
                      <div className="text-[11px] text-gray-600 mb-0.5">Email</div>
                      <p className="text-[14px] font-medium text-gray-800">sarah@email.com</p>
                    </div>
                    <Edit size={16} className="text-gray-400" />
                  </div>
                  <div className="flex items-center justify-between p-3 bg-[#f8edeb] rounded-xl">
                    <div>
                      <div className="text-[11px] text-gray-600 mb-0.5">Phone</div>
                      <p className="text-[14px] font-medium text-gray-800">+1 (555) 123-4567</p>
                    </div>
                    <Edit size={16} className="text-gray-400" />
                  </div>
                  <div className="flex items-center justify-between p-3 bg-[#f8edeb] rounded-xl">
                    <div>
                      <div className="text-[11px] text-gray-600 mb-0.5">Tag</div>
                      <div className="flex gap-2 mt-1">
                        <span className="px-3 py-1 bg-[#285301] text-white text-[11px] rounded-full">Family</span>
                      </div>
                    </div>
                    <Edit size={16} className="text-gray-400" />
                  </div>
                </div>
              </div>

              {/* RSVP & plus ones */}
              <div>
