                          >
                            <Copy size={12} />
                            Copy details
                          </button>
                        </div>
                      </div>
                    )}

                    {/* Additional sections for non-pending guests */}
                    {guestViewType !== 'pending' && (
                      <>
                        <div className="p-3 bg-white border border-gray-100 rounded-lg">
                          <div className="text-[12px] font-medium text-gray-800 mb-1">Venue</div>
                          <div className="text-[11px] text-gray-600">Sunset Gardens, Montego Bay</div>
                        </div>

                        <div className="p-3 bg-white border border-gray-100 rounded-lg">
                          <div className="text-[12px] font-medium text-gray-800 mb-1">Dress Code</div>
                          <div className="text-[11px] text-gray-600">Beach formal</div>
                        </div>
                      </>
                    )}
                  </div>
                )}
              </div>

              <div className="mt-4 flex gap-2">
                <button className="flex-1 py-2.5 bg-white border border-gray-200 rounded-lg text-[13px] font-medium text-gray-700 hover:border-[#285301] transition-all">
                  Copy guest link
                </button>
                <button className="flex-1 py-2.5 bg-[#285301] text-white rounded-lg text-[13px] font-medium hover:bg-[#1f4001] transition-all">
                  Publish updates
                </button>
              </div>
            </div>

            {/* Original settings for reference */}
            <div className="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
              <h3 className="text-lg font-medium text-[#285301] mb-4">Page settings</h3>
              <div className="space-y-3">
                {[
                  'Show couple photo',
                  'Show wedding story',
                  'Show event schedule',
                  'Show venue map',
                  'Show nearby hotels',
                  'Show dress code',
                  'Enable RSVP',
                  'Enable message board',
                  'Show registry',
                ].map((setting) => (
                  <div key={setting} className="flex items-center justify-between p-3 bg-[#f8edeb] rounded-lg">
                    <span className="text-sm">{setting}</span>
                    <input type="checkbox" defaultChecked className="w-4 h-4 rounded border-gray-300 text-[#285301]" />
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {activeTab === 'messages' && (
          <div className="space-y-6">
            {/* Page intro */}
            <div>
              <p className="text-[15px] text-gray-600 mb-4" style={{ lineHeight: 1.6 }}>
                Send updates, reminders, and guest communication without the back-and-forth.
              </p>
              <div className="flex gap-2 flex-wrap">
                <button className="bg-[#d45d78] text-white px-6 py-3 rounded-xl font-medium flex items-center gap-2 hover:bg-[#c14d68] transition-colors">
                  <Plus size={20} />
                  Compose Message
                </button>
                <button
                  onClick={() => setShowReminderModal(true)}
                  className="bg-white border border-gray-300 text-gray-700 px-6 py-3 rounded-xl font-medium hover:bg-gray-50 transition-colors flex items-center gap-2"
                >
                  <Send size={18} />
                  Send Reminder
                </button>
                <button className="bg-white border border-gray-300 text-gray-700 px-6 py-3 rounded-xl font-medium hover:bg-gray-50 transition-colors">
                  View Message History
                </button>
              </div>
            </div>

            {/* Module A: Smart Alerts */}
            <div className="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
              <h3 className="text-[17px] font-medium text-[#285301] mb-2">Smart Alerts</h3>
              <p className="text-[13px] text-gray-600 mb-4" style={{ lineHeight: 1.5 }}>
                Use quick actions to communicate based on guest status.
              </p>

              <div className="space-y-3">
                {[
                  { count: 18, text: 'guests have not RSVP\'d', action: 'Send reminder', icon: AlertCircle, color: '#d45d78' },
                  { count: 12, text: 'travelling guests still need hotel details', action: 'Send travel reminder', icon: Plane, color: '#285301' },
                  { count: 7, text: 'guests missing meal choices', action: 'Send meal request', icon: UsersIcon, color: '#d45d78' },
                  { count: 0, text: 'Wedding party schedule updated', action: 'Notify wedding party', icon: Calendar, color: '#285301' },
                ].map((alert, index) => (
                  <div key={index} className="flex items-center justify-between p-4 bg-gradient-to-r from-[#f8edeb] to-white rounded-xl border border-gray-100">
                    <div className="flex items-center gap-3 flex-1">
                      <div
                        className="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0"
                        style={{ backgroundColor: `${alert.color}15` }}
                      >
                        <alert.icon size={18} style={{ color: alert.color }} />
                      </div>
                      <div className="flex-1">
                        <div className="text-[14px] text-gray-800">
                          {alert.count > 0 && <span className="font-medium text-[#285301]">{alert.count} </span>}
                          {alert.text}
                        </div>
                      </div>
                    </div>
                    <button
                      onClick={() => setShowReminderModal(true)}
                      className="px-4 py-2 bg-[#285301] text-white rounded-lg text-[13px] font-medium hover:bg-[#1f4001] transition-colors flex-shrink-0"
                    >
                      {alert.action}
                    </button>
                  </div>
                ))}
              </div>
            </div>

            {/* Module B: Audience Messaging */}
            <div className="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
              <h3 className="text-[17px] font-medium text-[#285301] mb-2">Audience Messaging</h3>
              <p className="text-[13px] text-gray-600 mb-4" style={{ lineHeight: 1.5 }}>
                Send messages to specific guest groups.
              </p>

              <div className="flex gap-2 overflow-x-auto pb-2 -mx-1 px-1">
                {[
                  { label: 'All guests', count: 120 },
                  { label: 'Pending RSVP', count: 18 },
                  { label: 'Wedding party', count: 8 },
                  { label: 'Travelling guests', count: 32 },
                  { label: 'Family', count: 24 },
                  { label: 'Friends', count: 64 },
                  { label: 'Custom tags', count: 0 },
                ].map((segment, index) => (
                  <button
                    key={index}
                    className="px-4 py-2.5 bg-[#f8edeb] text-gray-800 rounded-xl text-[13px] font-medium hover:bg-[#d45d78] hover:text-white transition-colors flex-shrink-0 whitespace-nowrap"
                  >
                    {segment.label}
                    <span className="ml-2 opacity-70">({segment.count})</span>
                  </button>
                ))}
              </div>

              <div className="mt-5 p-4 bg-gradient-to-br from-[#f8edeb]/40 to-white rounded-xl border border-gray-100">
                <div className="flex items-center justify-between">
                  <div>
                    <div className="text-[13px] font-medium text-gray-800 mb-1">Ready to compose?</div>
                    <div className="text-[11px] text-gray-600">Select an audience above to start a new message</div>
                  </div>
                  <button className="px-5 py-2.5 bg-[#285301] text-white rounded-lg text-[13px] font-medium hover:bg-[#1f4001] transition-colors flex items-center gap-2">
                    <Plus size={16} />
                    Compose
                  </button>
                </div>
              </div>
            </div>

            {/* Module C: Messages from guests */}
            <div className="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
              <h3 className="text-[17px] font-medium text-[#285301] mb-2">Messages from guests</h3>
              <p className="text-[13px] text-gray-600 mb-4" style={{ lineHeight: 1.5 }}>
                Warm messages and notes from your guests.
              </p>

              <div className="space-y-3">
                {[
                  { name: 'Jessica M.', message: 'So excited to celebrate with you both! Wishing you all the love and happiness.', time: '2 hours ago', avatar: 'JM' },
                  { name: 'Thomas R.', message: 'Congratulations! We cannot wait for this beautiful day.', time: '5 hours ago', avatar: 'TR' },
                  { name: 'Maria G.', message: 'Sending love and blessings from our family to yours. ❤️', time: '1 day ago', avatar: 'MG' },
                ].map((msg, idx) => (
                  <button
                    key={idx}
                    className="w-full p-4 bg-gradient-to-r from-[#f8edeb] to-white rounded-xl border border-gray-100 hover:border-[#d45d78] transition-all text-left group"
                  >
                    <div className="flex items-start gap-3">
                      <div className="w-10 h-10 rounded-full bg-[#285301] text-white flex items-center justify-center text-[12px] font-medium flex-shrink-0">
                        {msg.avatar}
                      </div>
                      <div className="flex-1 min-w-0">
                        <div className="flex items-center justify-between mb-1.5">
                          <span className="text-[14px] font-medium text-gray-800">{msg.name}</span>
                          <span className="text-[11px] text-gray-500">{msg.time}</span>
                        </div>
                        <p className="text-[13px] text-gray-700 line-clamp-2">{msg.message}</p>
                      </div>
                      <ChevronRight size={16} className="text-gray-400 flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity" />
                    </div>
                  </button>
                ))}
              </div>

              <button className="w-full mt-4 py-3 border border-gray-200 text-gray-700 rounded-xl text-[13px] font-medium hover:bg-gray-50 transition-colors">
                View all messages
              </button>
            </div>
          </div>
        )}

        {activeTab === 'logistics' && (
          <div className="space-y-6">
            {/* Page intro */}
            <div>
              <p className="text-[15px] text-gray-600" style={{ lineHeight: 1.6 }}>
                Identify which guests need support, prioritize actions, and ensure everyone arrives smoothly.
              </p>
            </div>

            {/* Section 1: Logistics Action Center - TOP PRIORITY */}
            <div className="bg-[#F9EDEE] rounded-2xl p-5 border border-[#C75C6F]/20">
              <div className="flex items-start justify-between mb-3">
                <div>
                  <h3 className="text-[18px] font-medium text-[#1F4D2B] mb-1" style={{ fontFamily: 'Playfair Display, serif' }}>
                    Logistics Action Center
                  </h3>
                  <p className="text-[13px] text-gray-600">
                    Immediate actions required to ensure all guests arrive smoothly
                  </p>
                </div>
              </div>

              {/* Alert cards - horizontal scroll on mobile */}
              <div className="flex gap-3 overflow-x-auto pb-2 -mx-5 px-5">
                <div className="bg-white rounded-xl p-4 min-w-[280px] flex-shrink-0 border border-[#C75C6F]/20">
                  <div className="flex items-start gap-3">
                    <div className="w-10 h-10 rounded-full bg-[#F9EDEE] flex items-center justify-center flex-shrink-0">
                      <AlertCircle size={20} className="text-[#C75C6F]" />
                    </div>
                    <div className="flex-1">
                      <div className="text-[14px] font-medium text-gray-800 mb-1">8 guests arriving in 72 hours without transport</div>
                      <div className="text-[12px] text-gray-600 mb-3">These guests may not reach the venue on time</div>
                      <button
                        onClick={() => setShowEditTransport(true)}
                        className="px-4 py-2 bg-[#1F4D2B] text-white rounded-lg text-[13px] hover:bg-[#163920] transition-colors"
                        style={{ fontWeight: 500 }}
                      >
                        Assign transport
                      </button>
                    </div>
                  </div>
                </div>

                <div className="bg-white rounded-xl p-4 min-w-[280px] flex-shrink-0 border border-[#C75C6F]/20">
                  <div className="flex items-start gap-3">
                    <div className="w-10 h-10 rounded-full bg-[#F9EDEE] flex items-center justify-center flex-shrink-0">
                      <Hotel size={20} className="text-[#C75C6F]" />
                    </div>
                    <div className="flex-1">
                      <div className="text-[14px] font-medium text-gray-800 mb-1">14 guests have no hotel assigned</div>
                      <div className="text-[12px] text-gray-600 mb-3">They may struggle with accommodation planning</div>
                      <button
                        onClick={() => setShowEditHotels(true)}
                        className="px-4 py-2 bg-[#1F4D2B] text-white rounded-lg text-[13px] hover:bg-[#163920] transition-colors"
                        style={{ fontWeight: 500 }}
                      >
                        Assign hotels
                      </button>
                    </div>
                  </div>
                </div>

                <div className="bg-white rounded-xl p-4 min-w-[280px] flex-shrink-0 border border-[#C75C6F]/20">
                  <div className="flex items-start gap-3">
                    <div className="w-10 h-10 rounded-full bg-[#F9EDEE] flex items-center justify-center flex-shrink-0">
                      <Plane size={20} className="text-[#C75C6F]" />
                    </div>
                    <div className="flex-1">
                      <div className="text-[14px] font-medium text-gray-800 mb-1">6 guests missing flight details</div>
                      <div className="text-[12px] text-gray-600 mb-3">Arrival timing cannot be coordinated</div>
                      <button
                        onClick={() => setShowComposeMessage(true)}
                        className="px-4 py-2 bg-[#1F4D2B] text-white rounded-lg text-[13px] hover:bg-[#163920] transition-colors"
                        style={{ fontWeight: 500 }}
                      >
                        Request details
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            {/* Section 2: Logistics Overview - problem-focused KPIs */}
            <div className="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
              <h3 className="text-[18px] font-medium text-[#1F4D2B] mb-4" style={{ fontFamily: 'Playfair Display, serif' }}>
                Logistics Overview
              </h3>
              <p className="text-[13px] text-gray-600 mb-5">
                High-level readiness across travel, stay, and transport
              </p>

              <div className="grid grid-cols-2 gap-3">
                <button
                  onClick={() => setActiveTab('guests')}
                  className="p-4 bg-[#F9EDEE] rounded-xl text-left hover:shadow-md transition-all"
                >
                  <div className="text-[24px] font-medium text-[#C75C6F] mb-1">8</div>
                  <div className="text-[13px] text-gray-800 font-medium">Flights Missing</div>
                </button>

                <button
                  onClick={() => setShowEditHotels(true)}
                  className="p-4 bg-[#F9EDEE] rounded-xl text-left hover:shadow-md transition-all"
                >
                  <div className="text-[24px] font-medium text-[#C75C6F] mb-1">14</div>
                  <div className="text-[13px] text-gray-800 font-medium">Hotels Not Assigned</div>
                </button>

                <button
                  onClick={() => setShowEditTransport(true)}
                  className="p-4 bg-[#F9EDEE] rounded-xl text-left hover:shadow-md transition-all"
                >
                  <div className="text-[24px] font-medium text-[#C75C6F] mb-1">12</div>
                  <div className="text-[13px] text-gray-800 font-medium">Transport Not Assigned</div>
                </button>

                <button
                  onClick={() => setActiveTab('guests')}
                  className="p-4 bg-[#E8F3EC] rounded-xl text-left hover:shadow-md transition-all"
                >
                  <div className="text-[24px] font-medium text-[#1F4D2B] mb-1">18</div>
                  <div className="text-[13px] text-gray-800 font-medium">Fully Ready</div>
                </button>
              </div>
            </div>

            {/* Section 3: Travel Readiness Tracker */}
            <div className="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
              <h3 className="text-[18px] font-medium text-[#1F4D2B] mb-4" style={{ fontFamily: 'Playfair Display, serif' }}>
                Travel Readiness
              </h3>
              <p className="text-[13px] text-gray-600 mb-5">
                Track progress across key logistics inputs
              </p>

              <div className="space-y-4">
                {[
                  { label: 'Arrival dates collected', value: 28, total: 32, percentage: 88 },
                  { label: 'Departure dates collected', value: 26, total: 32, percentage: 81 },
                  { label: 'Flights added', value: 24, total: 32, percentage: 75 },
                  { label: 'Hotels assigned', value: 18, total: 32, percentage: 56 },
                  { label: 'Transport assigned', value: 12, total: 32, percentage: 38 },
                ].map((item) => {
                  const color = item.percentage >= 80 ? '#1F4D2B' : item.percentage >= 50 ? '#6B6B6B' : '#C75C6F';
                  return (
                    <button
                      key={item.label}
                      onClick={() => setActiveTab('guests')}
                      className="w-full text-left hover:bg-[#F7F7F5] -mx-2 px-2 py-2 rounded-lg transition-colors"
                    >
                      <div className="flex items-center justify-between mb-2">
                        <span className="text-[13px] text-gray-700">{item.label}</span>
                        <span className="text-[13px] font-medium text-gray-800">{item.value} / {item.total}</span>
                      </div>
                      <div className="w-full h-2.5 bg-[#F7F7F5] rounded-full overflow-hidden">
                        <div
                          className="h-full rounded-full transition-all"
                          style={{ width: `${item.percentage}%`, backgroundColor: color }}
                        />
                      </div>
                    </button>
                  );
                })}
              </div>
            </div>

            {/* Section 4: Guests Requiring Attention - CORE WORK AREA */}
            <div className="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
