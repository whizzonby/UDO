    { name: 'Michael Chen', role: 'Best man', email: 'michael@email.com', phone: '555-0101', speech: true },
    { name: 'Emily Davis', role: 'Bridesmaid', email: 'emily@email.com', phone: '555-0102', speech: false },
    { name: 'Jessica Lee', role: 'Bridesmaid', email: 'jessica@email.com', phone: '555-0103', speech: false },
    { name: 'Amanda White', role: 'Bridesmaid', email: 'amanda@email.com', phone: '555-0104', speech: false },
    { name: 'Rachel Green', role: 'Bridesmaid', email: 'rachel@email.com', phone: '555-0105', speech: false },
    { name: 'James Wilson', role: 'Groomsman', email: 'james@email.com', phone: '555-0106', speech: false },
    { name: 'David Brown', role: 'Groomsman', email: 'david@email.com', phone: '555-0107', speech: false },
    { name: 'Ryan Taylor', role: 'Groomsman', email: 'ryan@email.com', phone: '555-0108', speech: false },
    { name: 'Chris Martinez', role: 'Groomsman', email: 'chris@email.com', phone: '555-0109', speech: false },
