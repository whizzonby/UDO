                        <>
                          <p className="text-[13px] text-[#285301] mb-1" style={{ fontWeight: 500 }}>{vendor.name}</p>
                          <p className="text-[12px] text-gray-500" style={{ fontWeight: 400 }}>Booked {vendor.dateBooked}</p>
                        </>
                      )}
                      {vendor.status === 'Shortlisted' && (
                        <p className="text-[13px] text-gray-600" style={{ fontWeight: 400 }}>{vendor.shortlistedCount} options shortlisted</p>
                      )}
                      {vendor.status === 'Needed' && (
                        <p className="text-[13px] text-gray-500" style={{ fontWeight: 400 }}>Not yet sourced</p>
                      )}
                    </div>
                    <span className={`text-[10px] px-2 py-1 rounded-full text-white ${
                      vendor.status === 'Booked' ? 'bg-[#285301]' :
                      vendor.status === 'Shortlisted' ? 'bg-[#f194b2]' : 'bg-gray-300'
                    }`} style={{ fontWeight: 500 }}>
                      {vendor.status}
                    </span>
                  </div>
                  {vendor.status !== 'Booked' && (
                    <button onClick={() => setActiveFormModal('add-vendor')} className="text-[12px] text-[#285301] hover:underline mt-2" style={{ fontWeight: 500 }}>
                      {vendor.status === 'Shortlisted' ? 'Review options' : 'Add vendor'}
                    </button>
                  )}
                </div>
              ))}
            </div>

            <button onClick={() => setActiveFormModal('add-vendor')} className="w-full bg-[#285301] text-white py-3 rounded-xl mt-6 flex items-center justify-center" style={{ fontWeight: 500 }}>
              <Plus size={18} className="mr-2" />
