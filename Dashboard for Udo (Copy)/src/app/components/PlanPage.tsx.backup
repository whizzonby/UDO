    { category: 'Planner', status: 'Booked', name: 'Elite Weddings Co', dateBooked: 'Jan 20, 2026' },
    { category: 'Photographer', status: 'Booked', name: 'Emma Stone Photography', dateBooked: 'Feb 1, 2026' },
    { category: 'Videographer', status: 'Shortlisted', shortlistedCount: 3 },
    { category: 'Catering', status: 'Booked', name: 'Gourmet Affairs', dateBooked: 'Feb 10, 2026' },
    { category: 'Florist', status: 'Shortlisted', shortlistedCount: 2 },
