                        <p className="text-[12px] text-gray-600" style={{ fontWeight: 400 }}>{member.email}</p>
                        <p className="text-[12px] text-gray-600" style={{ fontWeight: 400 }}>{member.phone}</p>
                      </div>
                      {member.speech && (
                        <div className="mt-2">
                          <span className="text-[10px] px-2 py-1 bg-[#f8edeb] text-[#285301] rounded-full" style={{ fontWeight: 500 }}>
                            Speech planned
                          </span>
                        </div>
                      )}
                    </div>
                    <button onClick={() => setActiveFormModal('add-wedding-party-member')} className="text-gray-400 hover:text-[#285301]">
                      <Edit size={16} />
                    </button>
                  </div>
                </div>
              ))}
            </div>

            <div className="flex gap-3">
              <button onClick={() => setActiveFormModal('add-wedding-party-member')} className="flex-1 bg-[#285301] text-white py-3 rounded-xl flex items-center justify-center" style={{ fontWeight: 500 }}>
