    { id: 'tasks' as PlanTab, label: 'Tasks' },
    { id: 'budget' as PlanTab, label: 'Budget' },
    { id: 'vendors' as PlanTab, label: 'Vendors' },
    { id: 'details' as PlanTab, label: 'Details' },
