              <h2 className="text-[26px] text-[#285301]" style={{ fontFamily: 'Crimson Pro, serif', fontWeight: 500 }}>Seating</h2>
              <button onClick={() => setActiveModal(null)} className="text-gray-400 hover:text-gray-600">
                <X size={24} />
