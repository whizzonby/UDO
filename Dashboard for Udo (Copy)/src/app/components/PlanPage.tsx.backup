                  { category: 'Decor & flowers', spent: 2800, allocated: 4000, remaining: 1200 },
                  { category: 'Entertainment', spent: 1800, allocated: 3000, remaining: 1200 },
                  { category: 'Attire', spent: 2200, allocated: 3500, remaining: 1300 },
                  { category: 'Stationery', spent: 400, allocated: 800, remaining: 400 },
                  { category: 'Transport', spent: 300, allocated: 1200, remaining: 900 },
                ].map((item, idx) => (
                  <div key={idx}>
                    <div className="flex items-center justify-between mb-2">
                      <span className="text-[13px] text-gray-700" style={{ fontWeight: 500 }}>{item.category}</span>
                      <span className="text-[12px] text-gray-500" style={{ fontWeight: 400 }}>
                        ${item.spent.toLocaleString()} / ${item.allocated.toLocaleString()}
                      </span>
                    </div>
                    <div className="w-full bg-[#f8edeb]/50 rounded-full h-1.5">
                      <div className="bg-[#285301] h-1.5 rounded-full" style={{ width: `${(item.spent / item.allocated) * 100}%` }}></div>
                    </div>
                  </div>
                ))}
              </div>
