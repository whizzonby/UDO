              </div>
              <div className="bg-[#fefdfb] rounded-xl p-4 border border-gray-100 text-center">
                <div className="text-[12px] text-gray-500 mb-1" style={{ fontWeight: 400 }}>Spent</div>
                <div className="text-[24px] text-[#d45d78]" style={{ fontWeight: 500 }}>$31,500</div>
              </div>
              <div className="bg-[#285301] text-white rounded-xl p-4 text-center">
                <div className="text-[12px] opacity-90 mb-1" style={{ fontWeight: 400 }}>Remaining</div>
