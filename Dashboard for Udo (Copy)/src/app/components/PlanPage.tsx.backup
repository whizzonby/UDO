                <div
                  key={idx}
                  draggable
                  onDragStart={() => setDraggedTimelineMoment(idx)}
                  onDragEnd={() => setDraggedTimelineMoment(null)}
                  onDragOver={(e) => e.preventDefault()}
                  onDrop={(e) => {
                    e.preventDefault();
                    if (draggedTimelineMoment !== null && draggedTimelineMoment !== idx) {
                      const newMoments = [...timelineMoments];
                      const [removed] = newMoments.splice(draggedTimelineMoment, 1);
                      newMoments.splice(idx, 0, removed);
                      setTimelineMoments(newMoments);
                    }
                  }}
                  className="bg-[#fefdfb] rounded-xl p-4 border border-gray-100 cursor-move hover:border-[#285301] transition-all"
                >
                  <div className="flex items-start gap-3">
                    <button className="text-gray-400 hover:text-gray-600 mt-1 cursor-grab active:cursor-grabbing">
                      <GripVertical size={16} />
                    </button>
                    <div className="flex-1">
                      <div className="flex items-center justify-between mb-2">
                        <div className="flex items-center gap-2">
                          <span className="text-[14px] text-[#285301]" style={{ fontWeight: 600 }}>{item.time}</span>
                          <span className="text-[10px] px-2 py-0.5 bg-[#f8edeb] text-[#285301] rounded-full" style={{ fontWeight: 500 }}>
                            {item.type}
