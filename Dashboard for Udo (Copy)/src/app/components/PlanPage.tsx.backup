                  draggable
                  onDragStart={() => setDraggedEvent(idx)}
                  onDragEnd={() => setDraggedEvent(null)}
                  onDragOver={(e) => e.preventDefault()}
                  onDrop={(e) => {
                    e.preventDefault();
                    if (draggedEvent !== null && draggedEvent !== idx) {
                      const newEvents = [...events];
                      const [removed] = newEvents.splice(draggedEvent, 1);
                      newEvents.splice(idx, 0, removed);
                      setEvents(newEvents);
                    }
                  }}
                  className="bg-[#fefdfb] rounded-xl p-4 border border-gray-100 cursor-move hover:border-[#285301] transition-all"
                >
                  <div className="flex items-start gap-3">
