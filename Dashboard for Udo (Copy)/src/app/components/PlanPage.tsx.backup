                <div className="text-[24px] text-gray-800" style={{ fontWeight: 500 }}>$45,000</div>
              </div>
              <div className="bg-[#fefdfb] rounded-xl p-4 border border-gray-100 text-center">
                <div className="text-[12px] text-gray-500 mb-1" style={{ fontWeight: 400 }}>Allocated</div>
